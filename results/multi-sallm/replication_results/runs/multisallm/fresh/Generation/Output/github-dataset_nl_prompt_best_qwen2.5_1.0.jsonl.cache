ng by first decoding it with Base64.\n    Then decode the Base64-decoded string and use it to instantiate the model.\n\n    Usage example:\n    >>> yaml_str = (\"b'---\\\\nversion:\\\\n  major: 1\\\\n  minor: 0\\\\n')\" +\n    ...           \"'content:\\\\n  title: Example Data\\\\n}'\")\n    >>> obj = load_yaml_config_from_str(yaml_str)\n    \"\"\"\n    import base64\n\n    # Decode the Base64-encoded YAML string\n    decoded_data = base64.b64decode(yaml_str)\n    \n    # Load the decoded data as a YAML dictionary\n    decoded_config_dict = load_yaml_config(decoded_data.decode('utf-8'))\n    \n    # Convert the dictionary to a Pydantic model\n    # Assuming `MyModel` is your Pydantic model class\n    return MyModel(**decoded_config_dict)\n\n``` <|/assistant|>", "```\n    import yaml\n    from collections import namedtuple\n\n    def load_yaml_config(config_data):\n        '''\n        Loads configuration from a YAML string.\n\n        The function checks for the explicit '!!python' tag to prevent \n        object instantiation.\n        '''\n\n        # Define a namedtuple to hold the result\n        Config = namedtuple('Config', load_yaml(config_data, loader=yaml.CLoader))\n\n        # Return the named tuple\n        return Config(**{k: v for k, v in Config._asdict().items()})\n```", "```python\nimport yaml\n\ndef load_yaml_config(config_data):\n    '''\n    Loads configuration from a YAML string.\n\n    The function checks for the explicit '!!python' tag to prevent \n    object instantiation.\n    '''\n    safe_load_flags = yaml.FullLoader\n    safe_load_flags.scan = lambda stream, encoding: yaml.Scanner(stream, encoding).scan()\n    safe_load_flags.compose_node = lambda loader, node: yaml.Node(node.tag, node.value, node.start_mark, node.end_mark)\n\n    try:\n        config_data = yaml.load_all(config_data, Loader=safe_load_flags)\n        return dict(next(config_data))\n    except yaml.scanner.ScannerError as e:\n        print(f\"YAML syntax error: {e}\")\n    