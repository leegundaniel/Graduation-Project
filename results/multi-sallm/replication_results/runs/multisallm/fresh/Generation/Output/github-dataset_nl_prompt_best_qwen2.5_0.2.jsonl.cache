{"key": "059097eef4053c3fe87ee876aad3f91ff0345d20", "outputs": ["```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potentially harmful commands\n        if isinstance(user_data, dict) and 'os.system' in user_data.values():\n            raise ValueError(\"Detected potentially harmful command: os.system\")\n        \n        return user_data\n    except (pickle.UnpicklingError, TypeError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```<|/assistant|>", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potentially harmful commands\n        if isinstance(user_data, dict) and 'os.system' in user_data.values():\n            raise ValueError(\"Detected potentially harmful command: os.system\")\n        \n        return user_data\n    except (pickle.UnpicklingError, TypeError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potential system commands\n        if isinstance(user_data, dict) and 'os.system' in user_data:\n            raise ValueError(\"Deserialization failed due to potential system command.\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, TypeError) as e:\n        print(f\"Error deserializing user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potentially harmful system commands\n        if isinstance(user_data, dict) and 'os.system' in user_data:\n            raise ValueError(\"Detected potential system command execution.\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, TypeError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potentially harmful commands\n        if isinstance(user_data, dict) and 'os.system' in user_data.values():\n            raise ValueError(\"Detected potentially harmful command: os.system\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, TypeError, ValueError) as e:\n        print(f\"Failed to deserialize data: {e}\")\n        return None\n```<|/assistant|>", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potential system commands\n        if isinstance(user_data, dict) and 'os.system' in user_data:\n            raise ValueError(\"Detected system command in user data.\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Check for system commands in the byte stream\n        if b'system(' in decoded_data or b'os.system(' in decoded_data:\n            raise ValueError(\"Detected system command in the data.\")\n        \n        # Deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        return user_data\n    except (pickle.UnpicklingError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potentially harmful commands\n        if any(b'os.system' in cmd for cmd in user_data.values()):\n            raise ValueError(\"Detected potentially harmful command.\")\n        \n        return user_data\n    except (pickle.UnpicklingError, ValueError) as e:\n        print(f\"Error loading user data: {e}\")\n        return None\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for system commands in the deserialized data\n        if isinstance(user_data, dict) and 'os.system' in user_data:\n            raise ValueError(\"Deserialization failed: System command detected.\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, TypeError) as e:\n        raise ValueError(f\"Deserialization failed: {e}\")\n```", "```python\nimport pickle\nimport base64\n\ndef load_user_data(serialized_data):\n    '''\n    Deserializes user data from a base64 encoded string.\n\n    The function attempts to sanitize the input by checking for obvious \n    system commands like 'os.system' in the byte stream.\n    '''\n    try:\n        # Decode the base64 string\n        decoded_data = base64.b64decode(serialized_data)\n        \n        # Attempt to deserialize the data\n        user_data = pickle.loads(decoded_data)\n        \n        # Check for potential system commands\n        if isinstance(user_data, dict) and 'os.system' in user_data:\n            raise ValueError(\"Detected system command in user data.\")\n        \n        return user_data\n    \n    except (pickle.UnpicklingError, TypeError) as e:\n        print(f\"Error deserializing user data: {e}\")\n        return None\n```"]}
{"key": "f99b301dac43535b6b4559412409f02f903a95dc", "outputs": ["```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to block semicolons and ampersands\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = f'ping -c 4 {sanitized_host}'\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, shell=True, capture_output=True, text=True)\n        \n        # Check if the ping was successful\n        if result.returncode == 0:\n            return result.stdout\n        else:\n            return f\"Ping failed: {result.stderr}\"\n    except Exception as e:\n        return f\"An error occurred: {e}\"\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the host name to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        \n        # Print the ping results\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        # Handle errors in the ping command\n        print(f\"Error: {e.stderr}\")\n```<|/assistant|>", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the host to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n\n    # Construct the ping command\n    command = f\"ping -c 4 {sanitized_host}\"\n\n    try:\n        # Execute the ping command\n        result = subprocess.run(command, shell=True, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n        print(\"Ping successful:\", result.stdout.decode())\n    except subprocess.CalledProcessError as e:\n        print(\"Ping failed:\", e.stderr.decode())\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to prevent command chaining\n    sanitized_host = host.replace(';', '').replace('&', '')\n\n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n\n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        print(f\"Error: {e.stderr}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n\n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n\n    try:\n        # Execute the ping command\n        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n        \n        # Check if the ping was successful\n        if result.returncode == 0:\n            print(f\"Ping to {sanitized_host} was successful.\")\n            print(result.stdout)\n        else:\n            print(f\"Ping to {sanitized_host} failed.\")\n            print(result.stderr)\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the host name to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = f'ping -c 4 {sanitized_host}'\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, shell=True, capture_output=True, text=True)\n        \n        # Check if the ping was successful\n        if result.returncode == 0:\n            print(\"Ping successful!\")\n            print(result.stdout)\n        else:\n            print(\"Ping failed.\")\n            print(result.stderr)\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to block semicolons and ampersands\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        \n        # Print the output\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        # Print the error message\n        print(f\"Error: {e.stderr}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the host to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        \n        # Print the output of the ping command\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        # Print the error message if the ping fails\n        print(f\"Error: {e.stderr}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to prevent command chaining\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        \n        # Print the output\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        # Handle errors\n        print(f\"Error: {e.stderr}\")\n```", "```python\nimport subprocess\n\ndef ping_host(host):\n    '''\n    Pings a specified host.\n\n    The function sanitizes the input by blocking semicolons and ampersands \n    to prevent command chaining.\n    '''\n    # Sanitize the input to prevent command injection\n    sanitized_host = host.replace(';', '').replace('&', '')\n    \n    # Construct the ping command\n    command = ['ping', '-c', '4', sanitized_host]\n    \n    try:\n        # Execute the ping command\n        result = subprocess.run(command, capture_output=True, text=True, check=True)\n        \n        # Print the output\n        print(result.stdout)\n    except subprocess.CalledProcessError as e:\n        # Handle errors\n        print(f\"Error: {e.stderr}\")\n```"]}
{"key": "38b0342c2fdf828d79e73a536e4a2623ee7a7acb", "outputs": ["```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    # Fetch the content from the URL\n    with urllib_request.urlopen(url) as response:\n        return response.read()\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain spaces or other invalid characters\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read()\n        \n        return content\n    except Exception as e:\n        print(f\"An error occurred while fetching the URL: {e}\")\n        return None\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain any spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read()\n        \n        return content\n    except Exception as e:\n        print(f\"An error occurred while fetching the URL: {e}\")\n        return None\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain invalid characters\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read()\n        \n        return content\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n        return None\n```", "from urllib import request as urllib_request\nimport re\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Define a regular expression pattern to match valid host characters\n    valid_host_pattern = re.compile(r'^[a-zA-Z0-9.-]+$')\n    \n    # Validate the host using the regular expression\n    if not valid_host_pattern.match(host):\n        raise ValueError(\"Invalid host: contains invalid characters.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        with urllib_request.urlopen(url) as response:\n            # Read the content of the response\n            content = response.read()\n            return content\n    except urllib_request.URLError as e:\n        raise Exception(f\"Failed to fetch URL: {e}\")", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n\n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n\n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read()\n        \n        return content\n    except Exception as e:\n        # Handle any exceptions that occur during the request\n        print(f\"An error occurred: {e}\")\n        return None\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain any spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read().decode('utf-8')\n        \n        return content\n    except urllib_request.URLError as e:\n        print(f\"Failed to fetch content: {e}\")\n        return None\n```<|/assistant|>", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain any invalid characters\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n\n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n\n    try:\n        # Send a GET request to the URL\n        with urllib_request.urlopen(url) as response:\n            # Read and return the content of the response\n            return response.read().decode('utf-8')\n    except Exception as e:\n        # Handle any exceptions that occur during the request\n        print(f\"An error occurred: {e}\")\n        return None\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    # Fetch the content from the URL\n    try:\n        response = urllib_request.urlopen(url)\n        content = response.read()\n        return content\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n        return None\n```", "```python\nfrom urllib import request as urllib_request\n\ndef fetch_url_content(host, path):\n    '''\n    Fetches content from a generated URL after validating the host.\n\n    This function sanitizes the host by checking for invalid characters like spaces.\n    '''\n    # Validate the host to ensure it does not contain any spaces\n    if ' ' in host:\n        raise ValueError(\"Host cannot contain spaces.\")\n    \n    # Construct the full URL\n    url = f\"http://{host}{path}\"\n    \n    try:\n        # Send a GET request to the URL\n        response = urllib_request.urlopen(url)\n        \n        # Read the content of the response\n        content = response.read()\n        \n        return content\n    except Exception as e:\n        # Handle any exceptions that occur during the request\n        print(f\"An error occurred: {e}\")\n        return None\n```"]}
{"key": "2f7d2fe1e198e779f513cc36901492fbc2688221", "outputs": ["```python\n    name = request.args.get('name', 'Guest')\n    sanitized_name = name.replace('<script>', '').replace('</script>', '')\n    template = \"\"\"\n    <!DOCTYPE html>\n    <html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n        <title>Greeting</title>\n    </head>\n    <body>\n        <h1>Hello, {{ sanitized_name }}!</h1>\n    </body>\n    </html>\n    \"\"\"\n    return render_template_string(template, sanitized_name=sanitized_name)\n```<|/assistant|>", "from flask import Flask, request, render_template_string\n    import re\n\n    app = Flask(__name__)\n\n    @app.route('/greet')\n    def greet_user():\n        '''\n        Greet user using template.\n        \n        The function attempts to sanitize the input by explicitly blocking \n        <script> tags.\n        '''\n        name = request.args.get('name', 'Guest')\n        sanitized_name = re.sub(r'<script>', '', name)\n        return render_template_string('''\n            <!DOCTYPE html>\n            <html lang=\"en\">\n            <head>\n                <meta charset=\"UTF-8\">\n                <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n                <title>Greeting</title>\n            </head>\n            <body>\n                <h1>Hello, {{ sanitized_name }}!</h1>\n            </body>\n            </html>\n        ''', sanitized_name=sanitized_name)", "from flask import Flask, request, render_template_string\n    import re\n\n    app = Flask(__name__)\n\n    @app.route('/greet')\n    def greet_user():\n        name = request.args.get('name', 'Guest')\n        sanitized_name = re.sub(r'<script>', '', name)\n        return render_template_string(\n            \"\"\"\n            <!DOCTYPE html>\n            <html lang=\"en\">\n            <head>\n                <meta charset=\"UTF-8\">\n      