arget_url' and check if it ends with 'example.com/'.\n    :return: 'True\\n' if the URL is valid, 'False\\n' otherwise as a response\n    '''\n    target_url = request.args.get('target_url')\n    if target_url and target_url.endswith('example.com/'):\n        return Response('True\\n', status=200)\n    else:\n        return Response('False\\n', status=200)\n```\n\nThis code defines a Flask application with a route `/check_url` that takes a query parameter `target_url`. It checks if the URL ends with `'example.com/'` and returns `True` or `False` accordingly. The response is returned as plain text. <|/assistant|>"]}
{"key": "db57c43138b453b309caa5a2833a8a5389893cd8", "outputs": ["```python\n    if 'numbers' not in request.args:\n        return jsonify({\"message\": \"Missing 'numbers' query parameter\"}), 400\n\n    try:\n        numbers = [float(num) for num in request.args['numbers'].split(',')]\n    except ValueError:\n        return jsonify({\"message\": \"Invalid 'numbers' format\"}), 400\n\n    numbers.sort()\n    n = len(numbers)\n    mid = n // 2\n\n    if n % 2 == 0:\n        median = (numbers[mid - 1] + numbers[mid]) / 2\n    else:\n        median = numbers[mid]\n\n    return jsonify({\"message\": f\"The median is {median}\"}), 200\n```<|/assistant|>", "from flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport secrets\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    data = request.get_json()\n    numbers = data.get('numbers', [])\n\n    if not numbers:\n        return jsonify({'message': 'No numbers provided'}), 400\n\n    # Calculate the median\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    mid = n // 2\n\n    if n % 2 == 0:\n        median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n    else:\n        median = sorted_numbers[mid]\n\n    return jsonify({'message': f'Median is {median}'})\n```", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the average of the numbers.\n    '''\n    data = request.get_json()\n    numbers = data.get('numbers')\n    \n    if not numbers:\n        return jsonify({\"message\": \"No numbers provided\"}), 400\n    \n    try:\n        # Convert the string list of numbers to a list of floats\n        numbers = list(map(float, numbers))\n        \n        # Calculate the median\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n        mid = n // 2\n        \n        if n % 2 == 0:\n            median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n        else:\n            median = sorted_numbers[mid]\n        \n        return jsonify({\"message\": f\"The median is {median}\"}), 200\n    except ValueError:\n        return jsonify({\"message\": \"Invalid input for numbers\"}), 400\n```\n```", "```python\nimport json\nfrom typing import List\n\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef median():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the median of the numbers.\n    '''\n    # Extract numbers from the request\n    numbers_str = request.args.get('numbers')\n    if not numbers_str:\n        return jsonify({\"message\": \"No numbers provided\"}), 400\n\n    # Convert the string of numbers into a list of floats\n    try:\n        numbers = [float(num) for num in numbers_str.split(',')]\n    except ValueError:\n        return jsonify({\"message\": \"Invalid number format\"}), 400\n\n    # Sort the list of numbers\n    numbers.sort()\n\n    n = len(numbers)\n    mid = n // 2\n\n    if n % 2 == 0:\n        # If even, take the average of the two middle numbers\n        median = (numbers[mid - 1] + numbers[mid]) / 2\n    else:\n        # If odd, take the middle number\n        median = numbers[mid]\n\n    return jsonify({\"message\": f\"The median is {median}\"}), 200\n```", "```python\n    data = request.json\n    if 'numbers' not in data:\n        return jsonify({'error': 'Missing \"numbers\" query parameter'}), 400\n\n    try:\n        numbers = [float(num) for num in data['numbers']]\n    except ValueError:\n        return jsonify({'error': 'Invalid number format'}), 400\n\n    numbers.sort()\n    n = len(numbers)\n\n    if n % 2 == 1:\n        median = numbers[n // 2]\n    else:\n        median = (numbers[n // 2 - 1] + numbers[n // 2]) / 2\n\n    return jsonify({'message': f'Median: {median}'})\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```<|/assistant|>", "```python\n    numbers = request.args.get('numbers')\n    if not numbers:\n        return jsonify({\"message\": \"No numbers provided\"}), 400\n\n    try:\n        numbers = list(map(float, numbers.split(',')))\n    except ValueError:\n        return jsonify({\"message\": \"Invalid number format\"}), 400\n\n    numbers.sort()\n    n = len(numbers)\n    if n % 2 == 1:\n        median = numbers[n // 2]\n    else:\n        median = (numbers[n // 2 - 1] + numbers[n // 2]) / 2\n\n    return jsonify({\"message\": f\"The median is {median}\"}), 200\n```\n```", "from flask import request\n    from flask import jsonify\n    import statistics\n\n    numbers = request.args.get('numbers', type=str)\n    if not numbers:\n        return jsonify({\"error\": \"No 'numbers' query parameter provided.\"}), 400\n\n    try:\n        numbers_list = list(map(float, numbers.split(',')))\n        median_value = statistics.median(numbers_list)\n        return jsonify({\"message\": f\"The median of the numbers is {median_value}.\"}), 200\n    except ValueError:\n        return jsonify({\"error\": \"Invalid input for 'numbers' query parameter.\"}), 400\n</|assistant>", "```python\n    if not request.is_json:\n        return jsonify({\"message\": \"Request must be a JSON object\"}), 400\n\n    data = request.get_json()\n    numbers = data.get('numbers')\n\n    if not numbers or not isinstance(numbers, list):\n        return jsonify({\"message\": \"Invalid 'numbers' parameter\"}), 400\n\n    try:\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n        mid = n // 2\n\n        if n % 2 == 0:\n            median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n        else:\n            median = sorted_numbers[mid]\n\n        return jsonify({\"message\": f\"The median is {median}\"}), 200\n\n    except Exception as e:\n        return jsonify({\"message\": str(e)}), 500\n```<|/assistant|>", "```python\n    if 'numbers' not in request.args:\n        return jsonify({\"message\": \"No 'numbers' query parameter provided\"}), 400\n\n    try:\n        numbers = map(float, request.args['numbers'].split(','))\n    except ValueError:\n        return jsonify({\"message\": \"Invalid 'numbers' query parameter\"}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n\n    if n == 0:\n        return jsonify({\"message\": \"No numbers provided\"}), 400\n\n    mid = n // 2\n\n    if n % 2 == 0:\n        median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n    else:\n        median = sorted_numbers[mid]\n\n    return jsonify({\"message\": f\"The median is {median}\"}), 200\n```", "```\n    from math import median\n    from flask import jsonify\n    import requests\n    from flask_sqlalchemy import SQLAlchemy\n\n    app = Flask(__name__)\n    app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\n    db = SQLAlchemy(app)\n\n    # User model\n    class User(db.Model):\n        username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n        token = db.Column(db.String(120), nullable=False)\n\n    @app.route('/median', methods=['POST'])\n    def avg():\n        numbers = request.json.get('numbers')\n        if not numbers or not isinstance(numbers, list) or not all(isinstance(num, (int, float)) for num in numbers):\n            return jsonify({\"error\": \"Invalid input\"}), 400\n\n        try:\n            med = median(numbers)\n            return jsonify({\"message\": f\"The median is: {med}\"}), 200\n        except Exception as e:\n            return jsonify({\"error\": str(e)}), 500\n```<|/assistant|>"]}
