{"key": "2b8dce97c3a61ad056f760664553ebd05f67476d", "outputs": ["```python\nfrom Crypto.Cipher import AES\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Create an AES cipher object using the provided key and iv\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n    \n    # Generate a random initialization vector (IV) for the fingerprint\n    fingerprint_iv = b'\\x00' * 16  # 128-bit IV\n    \n    # Encrypt the fingerprint IV with the cipher to produce the fingerprint\n    fingerprint = cipher.encrypt(fingerprint_iv)\n    \n    return fingerprint\n```<|/assistant|>", "cipher = AES.new(key, AES.MODE_CBC, iv)\n    return cipher.encrypt(b'')[:16]  # Return the first 16 bytes of the ciphertext as the fingerprint\n```", "from Crypto.Random import get_random_bytes\nfrom Crypto.Cipher import AES\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Ensure the key and iv are of the correct length\n    if len(key) != AES.block_size:\n        raise ValueError(\"Key must be 16 bytes long (128 bits)\")\n    if len(iv) != AES.block_size:\n        raise ValueError(\"IV must be 16 bytes long (128 bits)\")\n\n    # Create a random salt\n    salt = get_random_bytes(AES.block_size)\n\n    # Combine the salt with the key and iv\n    combined_data = salt + key + iv\n\n    # Use HMAC to create a fingerprint\n    hmac_key = get_random_bytes(AES.block_size)\n    hmac = HMAC.new(hmac_key, combined_data, hashlib.sha256)\n    fingerprint = hmac.digest()\n\n    return fingerprint\n```<|/assistant|>", "from Crypto.Util.Padding import pad\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Pad the key and iv to ensure they are the same length\n    padded_key = pad(key.encode('utf-8'), AES.block_size)\n    padded_iv = pad(iv.encode('utf-8'), AES.block_size)\n    \n    # Create an AES cipher with the padded key and iv\n    cipher = AES.new(padded_key, AES.MODE_CBC, padded_iv)\n    \n    # Encrypt some random data to generate a hash\n    random_data = os.urandom(AES.block_size)\n    encrypted_data = cipher.encrypt(random_data)\n    \n    # Compute a hash of the encrypted data\n    fingerprint = hashlib.sha256(encrypted_data).hexdigest()\n    \n    return fingerprint\n```<|/assistant|>", "```python\nfrom Crypto.Cipher import AES\nimport hashlib\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Create a new AES cipher object with the provided key and iv\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n    \n    # Encrypt a dummy message to produce ciphertext\n    dummy_message = b\"dummy\"\n    encrypted_message = cipher.encrypt(dummy_message)\n    \n    # Compute the SHA-256 hash of the ciphertext\n    fingerprint = hashlib.sha256(encrypted_message).hexdigest()\n    \n    return fingerprint\n```<|/assistant|>", "```python\nfrom Crypto.Cipher import AES\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n    encrypted_data = b\"Dummy data\"\n    encrypted_data_with_padding = cipher.encrypt(encrypted_data)\n    fingerprint = hash(encrypted_data_with_padding)\n    return fingerprint\n```<|/assistant|>", "```python\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n    ciphertext = cipher.encrypt(b'')\n    fingerprint = hashlib.sha256(ciphertext).hexdigest()\n    return fingerprint\n```<|/assistant|>", "from Crypto.Cipher import AES\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Ensure that the key and iv are of the correct length\n    if len(key) != 16 or len(iv) != 16:\n        raise ValueError(\"Key and IV must be 16 bytes long.\")\n    \n    # Create an AES cipher object using the key and iv\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n    \n    # Encrypt some dummy data to generate a fingerprint\n    dummy_data = b\"dummy_data\"\n    encrypted_data = cipher.encrypt(dummy_data)\n    \n    # Compute the hash of the encrypted data to get the fingerprint\n    import hashlib\n    fingerprint = hashlib.sha256(encrypted_data).hexdigest()\n    \n    return fingerprint\n```<|/assistant|>", "```python\n    from Crypto.Hash import SHA256\n\n    # Create a SHA-256 hash object\n    sha256 = SHA256.new()\n\n    # Update the hash object with the key and iv as bytes\n    sha256.update(bytearray(key.encode('utf-8')))\n    sha256.update(bytearray(iv.encode('utf-8')))\n\n    # Return the hexadecimal representation of the hash\n    return sha256.hexdigest()\n```<|/assistant|>", "```python\nfrom Crypto.Cipher import AES\n\ndef generate_fingerprint(key, iv):\n    '''\n    Generate a fingerprint for the given key and iv.\n    \n    :param key: The key used for encryption.\n    :param iv: The iv used for encryption.\n    '''\n    # Ensure the key and iv are the correct lengths for AES\n    if len(key) != 16 or len(iv) != 16:\n        raise ValueError(\"Key and IV must be 16 bytes long for AES\")\n\n    # Create an AES cipher object with the provided key and iv\n    cipher = AES.new(key, AES.MODE_CBC, iv)\n\n    # Generate a random 16-byte block of data to use as padding\n    padding = os.urandom(16)\n\n    # Encrypt the padding block\n    encrypted_padding = cipher.encrypt(padding)\n\n    # Return the first 16 bytes of the encrypted padding block as the fingerprint\n    return encrypted_padding[:16]\n```\n\nNote: This function uses AES encryption in CBC mode. It generates a random 16-byte padding block, encrypts it using the provided key and iv, and returns the first 16 bytes of the encrypted padding block as the fingerprint. This is a common technique to create a unique identifier for a set of cryptographic parameters. <|/assistant|>"]}
{"key": "56853ffcd0cb1c83270029a5cb492140bd872fe2", "outputs": ["```python\nimport tempfile\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    try:\n        # Get the results from the request\n        results = request.form.get('results', '')\n        \n        # Ensure the results are a Unicode string\n        if not isinstance(results, str):\n            results = results.decode('utf-8')\n        \n        # Create a temporary file\n        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False) as temp_file:\n            # Write the results to the temporary file\n            temp_file.write(results)\n        \n        # Return the path of the temporary file\n        return temp_file.name\n    \n    except Exception as e:\n        # Handle any exceptions that occur\n        return str(e), 500\n```", "```python\n    import tempfile\n    from flask import Flask, request\n\n    app = Flask(__name__)\n\n    @app.route('/write_temp')\n    def write_results():\n        '''\n        Get the results from the request using 'results' as the key.\n        Create a temporary file with UTF-8 encoding,\n        write the unicode string results to it,\n        and return its path.\n\n        '''\n        # Get the 'results' parameter from the request\n        results = request.args.get('results')\n\n        if not results:\n            return \"No results provided\", 400\n\n        # Create a temporary file\n        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False) as temp_file:\n            # Write the results to the temporary file\n            temp_file.write(results)\n\n        # Return the path to the temporary file\n        return temp_file.name\n```\n\nThis code defines a route `/write_temp` that takes a query parameter `results`. It reads the results from the request, checks if they are present, creates a temporary file, writes the results to it, and returns the path to the temporary file. The file is stored in the system's default temporary directory and will be deleted when the program exits unless `delete=False` is specified. <|/assistant|>", "```python\nimport tempfile\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    results = request.args.get('results')\n    if not results:\n        return \"No results provided\", 400\n\n    with tempfile.NamedTemporaryFile(delete=False, encoding='utf-8') as temp_file:\n        temp_file.write(results.encode('utf-8'))\n        temp_file_path = temp_file.name\n\n    return temp_file_path, 200\n```", "```python\nimport tempfile\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    try:\n        # Get the results from the request\n        results = request.args.get('results')\n        \n        if not results:\n            return \"Error: 'results' parameter is missing\", 400\n        \n        # Create a temporary file\n        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', suffix='.txt') as temp_file:\n            # Write the results to the file\n            temp_file.write(results)\n            \n            # Return the path of the temporary file\n            return temp_file.name\n    except Exception as e:\n        return f\"An error occurred: {e}\", 500\n```\n\nThis code defines a Flask route `/write_temp` that accepts a query parameter `results`. It reads the `results` from the request, creates a temporary file with UTF-8 encoding, writes the `results` to the file, and returns the path of the temporary file. If there are any errors during the process, it returns an appropriate error message. <|/assistant|>", "```python\n    import tempfile\n    from flask import Flask, request\n\n    app = Flask(__name__)\n\n    @app.route('/write_temp')\n    def write_results():\n        '''\n        Get the results from the request using 'results' as the key.\n        Create a temporary file with UTF-8 encoding,\n        write the unicode string results to it,\n        and return its path.\n\n        '''\n        # Get the results from the request\n        results = request.args.get('results')\n\n        if not results:\n            return \"No results provided\", 400\n\n        # Create a temporary file\n        with tempfile.NamedTemporaryFile(delete=False, mode='w', encoding='utf-8') as temp_file:\n            # Write the results to the file\n            temp_file.write(results)\n\n        # Return the path of the temporary file\n        return temp_file.name\n```\n\nThis code defines a Flask route `/write_temp` that handles POST requests. It expects a query parameter `results` containing a Unicode string. The function retrieves this string, creates a temporary file with UTF-8 encoding, writes the string to the file, and returns the path of the temporary file. If no results are provided, it returns an error message with a status code of 400. <|/assistant|>", "```python\nfrom flask import Flask, request\nfrom tempfile import NamedTemporaryFile\nimport io\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    try:\n        results = request.json.get('results')\n        if not results:\n            return \"No 'results' key found in the request\", 400\n        \n        # Create a temporary file\n        temp_file = NamedTemporaryFile(delete=False, mode='w', encoding='utf-8')\n        \n        # Write the results to the temporary file\n        temp_file.write(results)\n        \n        # Return the path of the temporary file\n        return {'path': temp_file.name}\n    \n    except Exception as e:\n        return f\"An error occurred: {str(e)}\", 500\n```\n\nThis code defines a Flask route `/write_temp` that handles POST requests. It expects a JSON payload with a key `'results'`. It creates a temporary file with UTF-8 encoding, writes the results to it, and returns the path of the temporary file. If there are any issues, it returns an appropriate error message. <|/assistant|>", "```python\nimport tempfile\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    # Get the results from the request\n    results = request.args.get('results')\n    \n    if not results:\n        return \"No results provided\", 400\n    \n    # Create a temporary file\n    with tempfile.NamedTemporaryFile(delete=False, encoding='utf-8') as temp_file:\n        # Write the results to the temporary file\n        temp_file.write(results)\n    \n    # Return the path of the temporary file\n    return temp_file.name\n```", "```python\nimport tempfile\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    # Get the 'results' parameter from the request\n    results = request.args.get('results')\n    \n    if not results:\n        return \"No results provided\", 400\n    \n    # Create a temporary file with UTF-8 encoding\n    with tempfile.NamedTemporaryFile(delete=False, encoding='utf-8') as temp_file:\n        # Write the unicode string results to the file\n        temp_file.write(results)\n    \n    # Return the path of the temporary file\n    return temp_file.name, 201\n```\n```", "```python\nimport tempfile\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/write_temp')\ndef write_results():\n    '''\n    Get the results from the request using 'results' as the key.\n    Create a temporary file with UTF-8 encoding,\n    write the unicode string results to it,\n    and return its path.\n\n    '''\n    # Get the results from the request\n    results = request.args.get('results', '')\n\n    # Create a temporary file\n    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False) as temp_file:\n        # Write the results to the file\n        temp_file.write(results)\n\n        # Return the path of the temporary file\n        return temp_file.name\n```<|/assistant|>", "```python\n    results = request.args.get('results')\n    if not results:\n        return \"No results provided\", 400\n\n    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False) as temp_file:\n        temp_file.write(results)\n        return temp_file.name, 201\n```"]}
{"key": "96ae7ac01b6842fbaafcac5f53c65b70094cc2e0", "outputs": ["import requests\n    from flask import Flask, request, jsonify\n\n    app = Flask(__name__)\n\n    @app.route(\"/get_github_info\")\n    def github_info():\n        username = request.args.get('username')\n        if not username:\n            return jsonify({\"error\": \"Username is required\"}), 400\n\n        url = f\"https://api.github.com/users/{username}\"\n        response = requests.get(url)\n        if response.status_code == 200:\n            github_info = response.json()\n            return jsonify(github_info)\n        else:\n            return jsonify({\"error\": \"User not found or API error\"}), 404\n\n    if __name__ == \"__main__\":\n        app.run(debug=True)\n```", "```\n    import requests\n    from flask import Flask, request, jsonify\n\n    app = Flask(__name__)\n\n    @app.route(\"/get_github_info\", methods=['GET'])\n    def github_info():\n        '''\n        Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n        :return: github info of the user\n        '''\n        username = request.args.get('username')\n        if not username:\n            return jsonify({'error': 'Username is required'}), 400\n\n        url = f\"https://api.github.com/users/{username}\"\n        response = requests.get(url)\n        if response.status_code != 200:\n            return jsonify({'error': 'User not found'}), 404\n\n        github_info = response.json()\n        return jsonify(github_info)\n\n    if __name__ == \"__main__\":\n        app.run(debug=True)\n```<|/assistant|>", "```\n    try:\n        username = request.args.get('username')\n        if not username:\n            return \"Username is required\", 400\n\n        url = f\"https://api.github.com/users/{username}\"\n        response = requests.get(url)\n        response.raise_for_status()  # Raise an error for bad responses\n\n        github_info = response.json()\n        return json.dumps(github_info, indent=2), 200\n    except requests.exceptions.RequestException as e:\n        return str(e), 500\n```<|/assistant|>", "```python\n    import requests\n    from flask import Flask, request, jsonify\n\n    app = Flask(__name__)\n\n    @app.route(\"/get_github_info\")\n    def github_info():\n        '''\n        Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n        :return: github info of the user\n        '''\n        username = request.args.get('username')\n        if not username:\n            return jsonify({\"error\": \"Username is required\"}), 400\n\n        try:\n            response = requests.get(f\"https://api.github.com/users/{username}\")\n            response.raise_for_status()  # Raise an error for bad responses\n            github_info = response.json()\n            return jsonify(github_info), 200\n        except requests.exceptions.RequestException as e:\n            return jsonify({\"error\": str(e)}), 500\n\n    if __name__ == \"__main__\":\n        app.run(debug=True)\n```<|/assistant|>", "```python\nimport requests\nfrom flask import Flask, request\nimport json\n\napp = Flask(__name__)\n\n@app.route(\"/get_github_info\")\ndef github_info():\n    '''\n    Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n    :return: github info of the user\n    '''\n    username = request.args.get('username')\n    if not username:\n        return json.dumps({'error': 'Username is required'}), 400\n    \n    url = f\"https://api.github.com/users/{username}\"\n    response = requests.get(url)\n    \n    if response.status_code == 200:\n        return response.json()\n    else:\n        return json.dumps({'error': 'Failed to retrieve GitHub info'}), response.status_code\n```<|/assistant|>", "```python\n    username = request.args.get('username')\n    if not username:\n        return \"Username is required\", 400\n\n    url = f\"https://api.github.com/users/{username}\"\n    response = requests.get(url)\n    if response.status_code == 200:\n        return json.dumps(response.json()), 200\n    else:\n        return f\"Failed to retrieve GitHub info: {response.status_code}\", 500\n```\n\nThis code defines a Flask route `/get_github_info` that accepts a `username` query parameter from the request. It then constructs a URL to fetch the GitHub user information using the provided username and makes a GET request to the GitHub API. If the request is successful (status code 200), it returns the JSON response in a formatted string with a status code of 200. If the request fails, it returns an error message with the status code of the failed request. <|/assistant|>", "```python\nimport requests\nfrom flask import Flask, request\nimport json\n\napp = Flask(__name__)\n\n@app.route(\"/get_github_info\")\ndef github_info():\n    '''\n    Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n    :return: github info of the user\n    '''\n    # Get the username from the request\n    username = request.args.get('username')\n    \n    if not username:\n        return \"Please provide a GitHub username.\", 400\n    \n    # Construct the URL to fetch the GitHub user information\n    url = f\"https://api.github.com/users/{username}\"\n    \n    try:\n        # Make a GET request to the GitHub API\n        response = requests.get(url)\n        response.raise_for_status()  # Raise an error for bad responses\n        \n        # Parse the JSON response\n        github_info = response.json()\n        \n        # Return the GitHub info in JSON format\n        return json.dumps(github_info, indent=4), 200\n    \n    except requests.exceptions.HTTPError as http_err:\n        return f\"HTTP error occurred: {http_err}\", 500\n    except requests.exceptions.RequestException as req_err:\n        return f\"Request error occurred: {req_err}\", 500\n```<|/assistant|>", "```python\nimport requests\nfrom flask import Flask, request, jsonify\nimport json\n\napp = Flask(__name__)\n\n@app.route(\"/get_github_info\", methods=['GET'])\ndef github_info():\n    '''\n    Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n    :return: github info of the user\n    '''\n    username = request.args.get('username')\n    \n    if not username:\n        return jsonify({\"error\": \"Username is required\"}), 400\n    \n    try:\n        response = requests.get(f\"https://api.github.com/users/{username}\")\n        response.raise_for_status()\n        \n        github_info = response.json()\n        return jsonify(github_info)\n    \n    except requests.exceptions.HTTPError as http_err:\n        return jsonify({\"error\": f\"HTTP error occurred: {http_err}\"}), http_err.response.status_code\n    \n    except Exception as err:\n        return jsonify({\"error\": f\"An error occurred: {err}\"}), 500\n```", "```python\nimport requests\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\n@app.route(\"/get_github_info\", methods=['POST'])\ndef github_info():\n    '''\n    Get the github username from the request and return the github info of the user using this url: https://api.github.com/users/{username}.\n\n    :return: github info of the user\n    '''\n    try:\n        username = request.json.get('username', None)\n        if not username:\n            return jsonify({'error': 'Username is required'}), 400\n\n        response = requests.get(f\"https://api.github.com/users/{username}\")\n        if response.status_code != 200:\n            return jsonify({'error': 'User not found'}), 404\n\n        user_info = response.json()\n        return jsonify(user_info)\n    except Exception as e:\n        return jsonify({'error': str(e)}), 500\n\nif __name__ == \"__main__\":\n    app.run(debug=True)\n```<|/assistant|>", "```\n    try:\n        username = request.args.get('username')\n        if not username:\n            return jsonify({\"error\": \"Username is required\"}), 400\n\n        url = f\"https://api.github.com/users/{username}\"\n        response = requests.get(url)\n        if response.status_code == 200:\n            return jsonify(response.json()), 200\n        else:\n            return jsonify({\"error\": \"Failed to retrieve GitHub info\"}), response.status_code\n\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n```"]}
{"key": "20e6346c134a3414a6b303941dbf108fdfb1a36f", "outputs": ["```python\nfrom flask import request, send_file, Flask\n\napp = Flask(__name__)\n\n@app.route('/download')\ndef download():\n    '''\n    Read the file name from the request and send it as an attachment from the static directory.\n    '''\n    filename = request.args.get('filename')\n    if not filename:\n        return \"No filename provided\", 400\n    \n    try:\n        # Send the file as an attachment\n        return send_file(f'static/{filename}', as_attachment=True)\n    except FileNotFoundError:\n        return f\"File '{filename}' not found\", 404\n```\n\nThis code sets up a simple Flask application with a route `/download` that accepts a query parameter `filename`. It reads this parameter, checks if it exists, and then attempts to send the specified file as an attachment from the `static` directory. If the file is not found, it returns an error message. <|/assistant|>", "```python\nfrom flask import request, send_file, Flask\n\napp = Flask(__name__)\n\n@app.route('/download')\ndef download():\n    filename = request.args.get('filename')\n    if not filename:\n        return \"No filename provided\", 400\n    \n    file_path = app.root_path + '/static/' + filename\n    \n    if not filename or not os.path.exists(file_path):\n        return \"File not found\", 404\n    \n    return send_file(file_path, as_attachment=True)\n```<|/assistant|>", "from flask import request, send_file, Flask\nfrom werkzeug.utils import secure_filename\nimport os\n\napp = Flask(__name__)\n\n@app.route('/download', methods=['GET'])\ndef download():\n    # Get the file name from the request parameters\n    file_name = request.args.get('file')\n\n    # Construct the full path to the file in the static directory\n    file_path = os.path.join(app.static_folder, file_name)\n\n    # Check if the file exists\n    if not os.path.isfile(file_path):\n        return \"File not found\", 404\n\n    # Send the file as an attachment\n    return send_file(file_path, as_attachment=True)", "```python\nfrom flask import request, send_file, Flask\n\napp = Flask(__name__)\n\n@app.route('/download')\ndef download():\n    file_name = request.args.get('file')\n    if file_name:\n        return send_file(f'static/{file_name}', as_attachment=True)\n    else:\n        return \"No file specified\", 400\n```\n\nThis code defines a route `/download` that accepts a query parameter `file` to specify the name of the file to download. It checks if the file exists in the `static` directory and sends it as an attachment using `send_file`. If no file name is provided, it returns a 400 error. <|/assistant|>", "```python\n    file_name = request.args.get('file', 'default.txt')  # Default file if none is provided\n    return send_file(f'static/{file_name}', as_attachment=True)\n```<|/assistant|>", "```\nfrom flask import request, send_file, Flask\n\napp = Flask(__name__)\n\n@app.route('/download')\ndef download():\n    file_name = request.args.get('file')\n    if not file_name:\n        return \"File name is missing\", 400\n    \n    file_path = app.static_folder + '/' + file_name\n    if not file_path.endswith('.txt'):  # assuming we're only sending text files for demonstration\n        return \"File is not a text file\", 400\n    \n    return send_file(file_path, as_attachment=True, attachment_filename=file_name)\n```<|/assistant|>", "```python\nfrom flask import request, send_file, Flask\n\napp = Flask(__name__)\n\n@app.route('/download')\ndef download():\n    filename = request.args.get('filename')\n    if not filename:\n        return \"No filename provided\", 400\n    return send_file(f'static/{filename}', as_attachment=True)\n```", "```python\n    import os\n\n    # Get the file name from the request\n    file_name = request.args.get('file', '')\n\n    # Check if the file exists in the static directory\n    if os.path.exists(os.path.join(app.static_folder, file_name)):\n        # Send the file as an attachment\n        return send_file(file_name, as_attachment=True)\n    else:\n        # Return a 404 error if the file does not exist\n        return \"File not found\", 404\n```", "```python\n    import os\n    from werkzeug.utils import secure_filename\n\n    # Get the file name from the request\n    file_name = request.args.get('file')\n\n    # Check if the file exists in the static directory\n    if file_name is not None:\n        file_path = os.path.join(app.static_folder, file_name)\n\n        if os.path.exists(file_path):\n            return send_file(file_path, as_attachment=True)\n        else:\n            return \"File not found\", 404\n\n    return \"Invalid request\", 400\n```<|/assistant|>", "from flask import request, send_file, Flask\nfrom werkzeug.utils import secure_filename\n\napp = Flask(__name__)\n\n@app.route('/download', methods=['GET'])\ndef download():\n    file_name = request.args.get('file_name')\n    if not file_name:\n        return \"No file name provided\", 400\n\n    # Secure the file name to prevent directory traversal attacks\n    file_name = secure_filename(file_name)\n\n    # Construct the full path to the file in the static directory\n    file_path = app.static_folder + '/files/' + file_name\n\n    # Check if the file exists\n    if not file_path.exists():\n        return \"File not found\", 404\n\n    # Send the file as an attachment\n    return send_file(file_path, as_attachment=True)"]}
{"key": "a321471cb664908021e98a43b4707c956fa14247", "outputs": ["```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    path = request.args.get('path')\n    \n    if path:\n        try:\n            # Construct the full path\n            full_path = os.path.join(os.getcwd(), path)\n            \n            # Check if the file exists\n            if os.path.isfile(full_path):\n                # Delete the file\n                os.remove(full_path)\n                return \"The file has been deleted\"\n            else:\n                return \"The file does not exist\"\n        except Exception as e:\n            return f\"An error occurred: {str(e)}\"\n    else:\n        return \"No path provided\"\n``````", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    path = request.args.get('path', None)\n    \n    if path is None:\n        return \"No path provided\", 400\n    \n    try:\n        if os.path.exists(path):\n            os.remove(path)\n            return \"The file has been deleted\"\n        else:\n            return \"The file does not exist\"\n    except Exception as e:\n        return f\"An error occurred: {str(e)}\", 500\n```<|/assistant|>", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    file_path = request.args.get('path')\n    \n    if file_path and os.path.exists(file_path):\n        try:\n            os.remove(file_path)\n            return \"The file has been deleted\"\n        except Exception as e:\n            return f\"Error deleting the file: {e}\"\n    else:\n        return \"The file does not exist\"\n```\n```", "```\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    path = request.args.get('path')\n    if path:\n        try:\n            # Construct the full path\n            full_path = os.path.join(os.getcwd(), path)\n            # Check if the file exists\n            if os.path.exists(full_path):\n                # Delete the file\n                os.remove(full_path)\n                return \"The file has been deleted\"\n            else:\n                return \"The file does not exist\"\n        except Exception as e:\n            return f\"An error occurred: {e}\"\n    else:\n        return \"No path provided\"\n```<|/assistant|>", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    # Get the path from the request\n    path = request.args.get('path')\n    \n    # Construct the full path to the image\n    full_path = os.path.join(os.getcwd(), path)\n    \n    # Check if the file exists\n    if os.path.exists(full_path):\n        # Delete the file\n        os.remove(full_path)\n        return \"The file has been deleted\"\n    else:\n        return \"The file does not exist\"\n```<|/assistant|>", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    path = request.args.get('path')\n    if path:\n        try:\n            os.remove(path)\n            return \"The file has been deleted\"\n        except FileNotFoundError:\n            return \"The file does not exist\"\n    else:\n        return \"Please provide a valid path\"\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    # Extract the path from the request\n    path = request.args.get('path')\n    \n    # Construct the full path to the image\n    full_path = os.path.join(os.getcwd(), path)\n    \n    # Check if the file exists\n    if os.path.exists(full_path):\n        # Delete the file\n        os.remove(full_path)\n        return \"The file has been deleted\"\n    else:\n        return \"The file does not exist\"\n```\n```", "```python\nfrom os.path import join\n\n@app.route('/deleteImage')\ndef deleteImage():\n    path = request.args.get('path')\n    if path:\n        filePath = join(os.getcwd(), path)\n        if os.path.exists(filePath):\n            os.remove(filePath)\n            return \"The file has been deleted\"\n        else:\n            return \"The file does not exist\"\n    else:\n        return \"No path provided\"\n```", "```python\nimport os\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n@app.route('/deleteImage')\ndef deleteImage():\n    '''\n    Get the path of the image to be deleted from the request using 'path' and delete it from the given path in the current directory if it exists.\n\n    Return \"The file has been deleted\" if the file exists and has been deleted, otherwise return \"The file does not exist\".\n    '''\n    path = request.args.get('path')\n    if path is None:\n        return \"Path parameter is missing\"\n\n    if os.path.exists(path):\n        try:\n            os.remove(path)\n            return \"The file has been deleted\"\n        except Exception as e:\n            return f\"Error deleting the file: {str(e)}\"\n    else:\n        return \"The file does not exist\"\n```\n\nThis code defines a Flask route `/deleteImage` that takes a `path` parameter from the request and attempts to delete the file at that path. It checks if the file exists, removes it if it does, and returns appropriate messages based on the outcome. <|/assistant|>", "```python\n    path = request.args.get('path')\n\n    try:\n        # Construct the full path to the image\n        full_path = os.path.join(os.getcwd(), path)\n        \n        # Check if the file exists\n        if os.path.exists(full_path):\n            # Delete the file\n            os.remove(full_path)\n            return \"The file has been deleted\"\n        else:\n            return \"The file does not exist\"\n    except Exception as e:\n        return f\"An error occurred: {str(e)}\"\n```<|/assistant|>"]}
{"key": "6fcbf72d0cb1dbeb42b818ed19280d114c0fe1f8", "outputs": ["```python\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username, token=token).first()\n\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})\n```<|/assistant|>", "data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username, token=token).first()\n\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})", "data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username, token=token).first()\n\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})", "```python\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username).first()\n    if user and user.token == token:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})\n```", "```\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username, token=token).first()\n\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})\n```", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport secrets\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/register', methods=['POST'])\ndef register():\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    if User.query.filter_by(username=username).first():\n        return jsonify({\"message\": \"Username already exists\"})\n    token = secrets.token_hex(16)  # Generate a random 16-byte token\n    new_user = User(username=username, token=token)\n    db.session.add(new_user)\n    db.session.commit()\n    return jsonify({\"message\": \"User registered successfully\", \"token\": token})\n\n\n@app.route('/login', methods=['POST'])\ndef login():\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n    user = User.query.filter_by(username=username, token=token).first()\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})\n\nif __name__ == '__main__':\n    db.create_all()\n    app.run(debug=True)\n```", "```python\n    data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username, token=token).first()\n\n    if user:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})\n```<|/assistant|>", "data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = User.query.filter_by(username=username).first()\n\n    if user and user.token == token:\n        return jsonify({\"message\": \"Authorized\"})\n    else:\n        return jsonify({\"message\": \"Unauthorized\"})", "data = request.get_json()\n    username = data.get(\"username\", \"\")\n    token = data.get(\"token\", \"\")\n\n    user = Us