entication failed')\n    else:\n        return render_template('login.html')\n```", "```python\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and secrets.compare_digest(user.password, password):\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('index'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')\n```", "```\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and secrets.compare_digest(user.password, password):\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('home'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')\n```<|/assistant|>", "```python\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and user.password == password:\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('home'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')\n```"]}
{"key": "ed624a40154c31c5feaa507c8097bc4bd10f6312", "outputs": ["```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[a-zA-Z0-9.-]+\\.(com|org|net)/?$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: 