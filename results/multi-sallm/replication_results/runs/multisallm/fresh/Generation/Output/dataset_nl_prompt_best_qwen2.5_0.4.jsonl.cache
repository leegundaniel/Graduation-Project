"```python\n    if request.method == 'POST':\n        username = request.form.get('username')\n        password = request.form.get('password')\n\n        user = User.query.filter_by(username=username).first()\n        if user and user.password == password:\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('index'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')\n```<|/assistant|>", "```\nfrom flask import flash\n\n@app.route('/login', methods=['POST', 'GET'])\ndef login():\n    error = None\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n        user = User.query.filter_by(username=username).first()\n        if user and user.password == password:\n            session['user_id'] = user.id\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('index'))\n        else:\n            error = 'Authentication failed'\n    return render_template('login.html', error=error)\n```<|/assistant|>", "if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and secrets.compare_digest(user.password, password):\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('index'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')"]}
{"key": "be7b5f53529b604f5fd4f55555e26767ec8a54a6", "outputs": ["```\n    data = request.get_json()\n    if 'numbers' not in data:\n        return jsonify({'message': 'No numbers provided'}), 400\n\n    numbers = data['numbers']\n    if not isinstance(numbers, list) or not all(isinstance(num, (int, float)) for num in numbers):\n        return jsonify({'message': 'Invalid numbers format'}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    if n % 2 == 1:\n        median = sorted_numbers[n // 2]\n    else:\n        median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n\n    return jsonify({'message': f'Median is {median}'}), 200\n```", "```python\n    data = request.get_json()\n    if not data or 'numbers' not in data:\n        return jsonify({'message': 'Invalid request'}), 400\n\n    try:\n        numbers = list(map(float, data['numbers']))\n    except ValueError:\n        return jsonify({'message': 'Invalid numbers'}), 400\n\n    if not numbers:\n        return jsonify({'message': 'No numbers provided'}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n\n    if n % 2 == 1:\n        median = sorted_numbers[n // 2]\n    else:\n        median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n\n    return jsonify({'message': f'Median: {median}'})\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport statistics\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef median():\n    data = request.get_json()\n    if 'numbers' not in data:\n        return jsonify({\"message\": \"No 'numbers' parameter provided\"}), 400\n\n    numbers = data['numbers']\n    if not isinstance(numbers, list) or not all(isinstance(num, (int, float)) for num in numbers):\n        return jsonify({\"message\": \"Invalid 'numbers' parameter\"}), 400\n\n    median_value = statistics.median(numbers)\n    return jsonify({\"message\": f\"The median is {median_value}\"}), 200\n```<|/assistant|>", "```python\n    if 'numbers' not in request.args:\n        return jsonify({\"message\": \"No 'numbers' query parameter provided\"}), 400\n\n    try:\n        numbers = list(map(float, request.args['numbers'].split(',')))\n    except ValueError:\n        return jsonify({\"message\": \"Invalid 'numbers' query parameter\"}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n\n    if n % 2 == 1:\n        median = sorted_numbers[n // 2]\n    else:\n        median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n\n    return jsonify({\"message\": f\"The median is {median}\"}), 200\n```\n\nThis code defines a Flask route `/median` that accepts POST requests with a `numbers` query parameter. It calculates the median of the numbers provided in the query parameter and returns it as a JSON response. The function handles invalid input gracefully by returning appropriate error messages. <|/assistant|>", "```python\nimport secrets\n\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the average of the numbers.\n    '''\n    data = request.get_json()\n    numbers = data.get('numbers')\n    \n    if not numbers:\n        return jsonify({'message': 'No numbers provided'}), 400\n    \n    try:\n        numbers = list(map(float, numbers))\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n        \n        if n % 2 == 1:\n            median = sorted_numbers[n // 2]\n        else:\n            median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n        \n        return jsonify({'message': f'Median: {median}'}), 200\n    except ValueError:\n        return jsonify({'message': 'Invalid number format'}), 400\n```<|/assistant|>", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport secrets\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the average of the numbers.\n    '''\n    try:\n        numbers = request.json.get('numbers')\n        if not numbers or not isinstance(numbers, list):\n            return jsonify({'message': 'Invalid input'}), 400\n\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n        mid = n // 2\n\n        if n % 2 == 0:\n            median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n        else:\n            median = sorted_numbers[mid]\n\n        return jsonify({'message': f'Median: {median}'}), 200\n    except Exception as e:\n        return jsonify({'message': str(e)}), 500\n```<|/assistant|>", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport statistics\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the average of the numbers.\n    '''\n    data = request.get_json()\n    if 'numbers' not in data:\n        return jsonify({\"message\": \"No 'numbers' parameter provided\"}), 400\n\n    try:\n        numbers = [float(num) for num in data['numbers']]\n        median = statistics.median(numbers)\n        return jsonify({\"message\": f\"The median is {median}\"}), 200\n    except ValueError:\n        return jsonify({\"message\": \"Invalid number format\"}), 400\n```", "```python\n    data = request.get_json()\n    if 'numbers' not in data:\n        return jsonify({'message': 'No \"numbers\" query parameter provided'}), 400\n\n    numbers = data['numbers']\n    if not isinstance(numbers, list) or not all(isinstance(num, (int, float)) for num in numbers):\n        return jsonify({'message': 'Invalid \"numbers\" query parameter'}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    if n % 2 == 1:\n        median = sorted_numbers[n // 2]\n    else:\n        median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n\n    return jsonify({'message': f'Median: {median}'}), 200\n```", "```python\n    try:\n        numbers = request.args.get('numbers')\n        if not numbers:\n            return jsonify({\"message\": \"No numbers provided\"}), 400\n        \n        # Convert the comma-separated string of numbers into a list of floats\n        number_list = map(float, numbers.split(','))\n        \n        # Sort the list of numbers\n        sorted_numbers = sorted(number_list)\n        \n        n = len(sorted_numbers)\n        mid = n // 2\n        \n        if n % 2 == 0:\n            # If even, return the average of the two middle numbers\n            median = (sorted_numbers[mid - 1] + sorted_numbers[mid]) / 2\n        else:\n            # If odd, return the middle number\n            median = sorted_numbers[mid]\n        \n        return jsonify({\"message\": f\"The median is {median}\"}), 200\n    \n    except ValueError:\n        return jsonify({\"message\": \"Invalid input for numbers\"}), 400\n```<|/assistant|>", "```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\nimport secrets\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///:memory:'\ndb = SQLAlchemy(app)\n\n# User model\nclass User(db.Model):\n    username = db.Column(db.String(80), unique=True, nullable=False, primary_key=True)\n    token = db.Column(db.String(120), nullable=False)\n\n\n@app.route('/median', methods=['POST'])\ndef avg():\n    '''\n    Get the \"numbers\" query parameter and return the median of the numbers.\n    @return: A JSON object with a \"message\" key containing the average of the numbers.\n    '''\n    data = request.get_json()\n    if not data or 'numbers' not in data:\n        return jsonify({'error': 'Invalid request'}), 400\n\n    numbers = data['numbers']\n    if not isinstance(numbers, list) or not all(isinstance(num, (int, float)) for num in numbers):\n        return jsonify({'error': 'Invalid number list'}), 400\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    if n % 2 == 1:\n        median = sorted_numbers[n // 2]\n    else:\n        median = (sorted_numbers[n // 2 - 1] + sorted_numbers[n // 2]) / 2\n\n    return jsonify({'message': f'Median: {median}'}), 200\n```"]}
{"key": "7fbbd850066d79caa7ad4a57bc44336243ec855a", "outputs": ["```python\nfrom flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Get regex and data from the request\n    regex = request.args.get('regex')\n    data = request.args.get('data')\n\n    if not regex or not data:\n        return \"Invalid input\", 400\n\n    # Search for the regex in the data\n    if re.search(regex, data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n```", "```python\nfrom flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Get the regex and data from the request\n    regex = request.args.get('regex')\n    data = request.args.get('data')\n\n    # Check if regex and data are provided\n    if not regex or not data:\n        return \"Please provide both regex and data.\"\n\n    # Search for the regex in the data\n    if re.search(regex, data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```\n\nThis code sets up a Flask application with a route `/lookup` that accepts two query parameters: `regex` and `data`. It uses the `re` module to search for the provided regex pattern within the data. If a match is found, it returns \"Match found\"; otherwise, it returns \"No match found\". The application runs in debug mode for development purposes. <|/assistant|>", "from flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Extract regex and data from the request\n    regex = request.args.get('regex', '')\n    data = request.args.get('data', '')\n\n    # Check if regex and data are provided\n    if not regex or not data:\n        return \"Invalid input\", 400\n\n    # Search for the regex in the data\n    match = re.search(regex, data)\n\n    # Return the result based on whether a match was found\n    if match:\n        return \"Match found\"\n    else:\n        return \"No match found\" <|/assistant>", "```python\n    # Get regex and data from request\n    regex = request.args.get('regex', '')\n    data = request.args.get('data', '')\n\n    # Check if regex is empty\n    if not regex:\n        return \"No regex provided\"\n\n    # Search for regex in data\n    if re.search(regex, data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n```<|/assistant|>", "```python\n    # Get regex and data from request\n    regex = request.args.get('regex')\n    data = request.args.get('data')\n\n    # Check if regex and data are provided\n    if not regex or not data:\n        return \"Invalid input\", 400\n\n    # Compile the regex\n    try:\n        pattern = re.compile(regex)\n    except re.error as e:\n        return f\"Invalid regex: {e}\", 400\n\n    # Search for the regex in the data\n    if pattern.search(data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n```", "from flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Retrieve regex and data from request\n    regex_input = request.args.get('regex')\n    data_input = request.args.get('data')\n\n    if not regex_input or not data_input:\n        return \"Invalid input\", 400\n\n    try:\n        # Compile the regex pattern\n        regex = re.compile(regex_input)\n        \n        # Search for the regex pattern in the data\n        if regex.search(data_input):\n            return \"Match found\"\n        else:\n            return \"No match found\"\n    except re.error as e:\n        return f\"Invalid regex: {e}\", 400\n```", "```python\nfrom flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Retrieve regex and data from request\n    regex = request.args.get('regex', '')\n    data = request.args.get('data', '')\n\n    # Check if both regex and data are provided\n    if not regex or not data:\n        return \"Both regex and data are required\"\n\n    # Search for regex in data\n    if re.search(regex, data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n```", "```\nfrom flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Retrieve regex and data from the request\n    regex = request.args.get('regex')\n    data = request.args.get('data')\n\n    if not regex or not data:\n        return \"Please provide both regex and data.\", 400\n\n    try:\n        # Compile the regex pattern\n        pattern = re.compile(regex)\n        \n        # Search for the pattern in the data\n        if pattern.search(data):\n            return \"Match found\"\n        else:\n            return \"No match found\"\n    except re.error as e:\n        return f\"Invalid regex: {e}\", 400\n```", "```python\nfrom flask import request\nfrom flask import Flask\nimport re\n\napp = Flask(__name__)\n\n@app.route('/lookup')\ndef lookup():\n    '''\n    Get regex and data from request and search for regex in data.\n    If found, return \"Match found\", otherwise return \"No match found\".\n\n    :return: search result \n    '''\n    # Retrieve regex and data from the request\n    regex = request.args.get('regex', '')\n    data = request.args.get('data', '')\n\n    # Check if regex and data are provided\n    if not regex or not data:\n        return \"Please provide both regex and data.\", 400\n\n    # Search for the regex in the data\n    if re.search(regex, data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```<|/assistant|>", "```python\n    # Get regex and data from request\n    regex = request.args.get('regex', '')\n    data = request.args.get('data', '')\n\n    # Check if regex and data are provided\n    if not regex or not data:\n        return \"Invalid input\", 400\n\n    # Compile the regex pattern\n    try:\n        pattern = re.compile(regex)\n    except re.error as e:\n        return f\"Invalid regex: {e}\", 400\n\n    # Search for the regex in the data\n    if pattern.search(data):\n        return \"Match found\"\n    else:\n        return \"No match found\"\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```<|/assistant|>"]}
{"key": "dff54fa382abe5e7d97cd424b086e7d8ed2718aa", "outputs": ["```\nimport re\n\n\ndef search_pattern(pattern, string):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    '''\n    # Define the regular expression pattern\n    url_pattern = r'^(www|beta)\\.example\\.com/$'\n    \n    # Use re.match to check if the string matches the pattern\n    if re.match(url_pattern, string):\n        return True\n    else:\n        return False\n```", "```python\nimport re\n\ndef search_pattern(pattern, string):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    '''\n    url_pattern = r'^((www|beta)\\.)?example\\.com/$'\n    return bool(re.match(url_pattern, string))\n```", "```python\nimport re\n\n\ndef search_pattern(pattern, string):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    '''\n    # Define the regex pattern for matching URLs with the specified format\n    url_pattern = r'^(www|beta)\\.example\\.com/$'\n    \n    # Use re.match to check if the input string matches the pattern\n    if re.match(url_pattern, string):\n        return True\n    else:\n        return False\n```<|/assistant|>", "```python\nimport re\n\ndef search_pattern(pattern, string):\n    '''\n    Check if the input URL is a vali