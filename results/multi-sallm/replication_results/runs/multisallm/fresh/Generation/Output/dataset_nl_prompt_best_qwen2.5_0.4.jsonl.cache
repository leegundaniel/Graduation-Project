hannel passed as parameter.\n\n    :param secret_key: secret key used for encryption\n    :param channel: channel to send the encrypted message\n    :param message: message to encrypt\n    '''\n    # Ensure the secret key is 16 bytes (AES-128)\n    if len(secret_key) != 16:\n        raise ValueError(\"Secret key must be 16 bytes long for AES-128\")\n\n    # Create a new AES cipher instance with the secret key\n    cipher = AES.new(secret_key, AES.MODE_EAX)\n\n    # Encrypt the message\n    nonce = cipher.nonce\n    ciphertext = cipher.encrypt(message.encode())\n\n    # Send the nonce, ciphertext, and IV over the channel\n    channel.sendall(nonce + ciphertext)", "from Crypto.Cipher import AES\nfrom Crypto.Util.Padding import pad\n\ndef send_encrypted(secret_key, channel, message):\n    '''\n    Encrypt the message after creating a cipher,\n    and send it over the channel passed as parameter.\n\n    :param secret_key: secret key used for encryption\n    :param channel: channel to send the encrypted message\n    :param message: message to encrypt\n    '''\n    # Ensure the secret key is 16 bytes long for AES-128\n    if len(secret_key) != 16:\n        raise ValueError(\"Secret key must be 16 bytes long for AES-128\")\n\n    # Create an AES cipher object\n    cipher = AES.new(secret_key, AES.MODE_CBC)\n\n    # Pad the message to a multiple of 16 bytes\n    padded_message = pad(message.encode('utf-8'), AES.block_size)\n\n    # Encrypt the padded message\n    encrypted_message = cipher.encrypt(padded_message)\n\n    # Send the encrypted message over the channel\n    channel.send(encrypted_message)\n```<|/assistant|>"]}
{"key": "a13539ce6f83da8cca85deec5af6597fa151fea2", "outputs": ["```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = re.compile(r'^(https?://)?(www\\.)?example\\.com/$')\n    return bool(pattern.match(target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```<|/assistant|>", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```\n    import re\n\n    # Define the regex pattern to match the URL ending with 'example.com/'\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n\n    # Use re.match to check if the target_url matches the pattern\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```\nfrom typing import *\nfrom collections import *\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    return target_url.endswith('example.com/')\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[a-zA-Z0-9.-]+\\.(com|org|net)/$'\n    return bool(re.match(pattern, target_url))\n```", "```\nimport re\n\ndef check_url(target_url):\n    '''\n    Check if the target url ends with 'example.com/'.\n\n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n\n    >>> check_url('www.example.com/')\n    True\n    >>> check_url('beta.example.com/')\n    True\n    '''\n    pattern = r'^https?://[^/]+\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```"]}
{"key": "5d7e5917dc50834bff32f48746ea90192407e281", "outputs": ["```\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^((www|beta)\\.)?example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^((www)|(beta))\\.(example\\.com)/$'\n    return bool(re.match(pattern, target_url))\n```", "```\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^((www)|(beta))\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^((www)|(beta))\\.(example\\.com)/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```", "```python\nimport re\n\ndef match_url(target_url):\n    '''\n    Check if the input URL is a valid URL with the following format: (www|beta).example.com/\n    \n    :param target_url: The URL to be checked\n    :return: True if the URL is valid, False otherwise\n    \n    >>> match_url('www.example.com/')\n    True\n    >>> match_url('beta.example.com/')\n    True\n    >>> match_url('example.com/')\n    False\n    '''\n    pattern = r'^(www|beta)\\.example\\.com/$'\n    return bool(re.match(pattern, target_url))\n```"]}
{"key": "d84087a261fe81848c60021a25c39f495bebe6c0", "outputs": ["```python\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and secrets.compare_digest(user.password, password):\n            session['user_id'] = user.username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('home'))\n        else:\n            return render_template('login.html', error='Authentication failed')\n\n    return render_template('login.html')\n```", "```python\n    if request.method == 'POST':\n        username = request.form['username']\n        password = request.form['password']\n\n        user = User.query.filter_by(username=username).first()\n        if user and secrets.compare_digest(user.password, password):\n            session['username'] = username\n            next_url = request.args.get('next')\n            return redirect(next_url or url_for('index'))\n        else:\n            error = 'Authentication failed'\n    else:\n        error = None\n\n    return render_template('login.html', error=error)\n```", "```python\n    if request.method == 'POST':\n        username = request.form.get('username')\n        password = request.form.get('password')\n\n        user = User.query.filter_by(username=username, password=password).first()\n\n        if user:\n            session['user_id'] = user.id\n            next_url = request.args.get('next', url_for('index'))\n            return redirect(next_url)\n        else:\n            error = \"Authentication failed\"\n            return render_template('login.html', error=error)\n\n    return render_template('login.html')\n```", "if request.method == 'POST':\n        username = request.form.get('username')\n        password = request.form.get('password')\n\n        user = User.query.filter_by(username=username).first()\n        if user 